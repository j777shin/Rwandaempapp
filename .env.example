# Backend API base URL — defaults to http://<current-host>:8001 if not set
VITE_API_BASE=http://localhost:8001

# Ingazi e-learning platform URL — defaults to http://localhost:3000 if not set
VITE_INGAZI_URL=http://localhost:3000
